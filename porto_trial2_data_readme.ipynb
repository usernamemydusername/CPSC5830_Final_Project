   "source": [
    "from torch.utils.data import Dataset\n",
    "\n",
    "class PortoPrefixShardDataset(Dataset):\n",
    "    def __init__(self, shard_paths):\n",
    "        self.examples = []\n",
    "        for p in shard_paths:\n",
    "            self.examples.extend(torch.load(p, map_location='cpu'))\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.examples)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        ex = self.examples[idx]\n",
    "        prefix = torch.tensor(ex['prefix_region_seq'], dtype=torch.long)\n",
    "        dest_region = torch.tensor(ex['dest_region'], dtype=torch.long)\n",
    "        dest_offset = torch.tensor([ex['dest_offset_x'], ex['dest_offset_y']], dtype=torch.float)\n",
    "        meta = {\n",
    "            'timestamp': ex.get('timestamp'),\n",
    "            'call_type': ex.get('call_type'),\n",
    "            'origin_call': ex.get('origin_call'),\n",
    "            'origin_stand': ex.get('origin_stand'),\n",
    "            'taxi_id': ex.get('taxi_id'),\n",
    "            'day_type': ex.get('day_type'),\n",
    "        }\n",
    "        return {\n",
