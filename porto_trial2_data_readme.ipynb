    "def load_first_shard(split='train'):\n",
    "    shard_dir = DATA_DIR / 'supervised_shards' / split\n",
    "    shard_paths = sorted(shard_dir.glob(f'{split}_*.pt'))\n",
    "    if not shard_paths:\n",
    "        raise FileNotFoundError(f'No shards found in {shard_dir}')\n",
    "    shard = torch.load(shard_paths[0], map_location='cpu')\n",
    "    return shard_paths[0], shard\n",
    "\n",
